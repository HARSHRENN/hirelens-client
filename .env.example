# Set in Vercel → Project → Settings → Environment Variables.
#
# Database and login: added automatically when you connect Supabase from
# Vercel → Storage → Create Database → Supabase. Nothing to copy by hand:
#   SUPABASE_URL, SUPABASE_ANON_KEY (or SUPABASE_PUBLISHABLE_KEY),
#   SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_SECRET_KEY), POSTGRES_URL_NON_POOLING, ...

# Who gets the /admin panel (comma-separated). Sign up with this email.
ADMIN_EMAILS=you@example.com

# Any long random string. Vercel sends it to /api/cron so nobody else can trigger the daily job.
CRON_SECRET=

# Optional: the public URL, used in email links (defaults to the request's host).
APP_URL=

# Optional fallbacks. The admin normally sets these in /admin → Keys and plan (stored in the database).
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
